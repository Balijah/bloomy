# ─────────────────────────────────────────────────────────────────────────────
# Bloomy — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string (overrides individual PG* vars if set)
DATABASE_URL=postgresql://user:password@localhost:5432/bloomy

# Individual PostgreSQL connection params (used by drizzle-kit and pg directly)
PGHOST=localhost
PGPORT=5432
PGUSER=user
PGPASSWORD=password
PGDATABASE=bloomy

# ── API Server ────────────────────────────────────────────────────────────────
# Port the Express API server listens on
PORT=8080

# ── Clerk Authentication ──────────────────────────────────────────────────────
# Server-side Clerk secret key (never expose to browser)
# Get from: https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_test_...

# Clerk publishable key (used by the API server for middleware config)
CLERK_PUBLISHABLE_KEY=pk_test_...

# Vite-exposed Clerk publishable key (used by the web frontend)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# URL Clerk auth requests are proxied through (keeps Clerk traffic on your domain)
# Typically: https://<your-domain>/api/__clerk
VITE_CLERK_PROXY_URL=https://your-domain.com/api/__clerk

# ── Stripe Payments ───────────────────────────────────────────────────────────
# Stripe secret key — used server-side only for checkout + portal sessions
# Get from: https://dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_...

# Stripe Price IDs for each subscription tier
# Get from: https://dashboard.stripe.com → Products
STRIPE_PRICE_GROWER=price_...
STRIPE_PRICE_GROWER_PRO=price_...

# ── SendGrid Email ────────────────────────────────────────────────────────────
# SendGrid API key for sending weekly digest emails
# Get from: https://app.sendgrid.com → Settings → API Keys
SENDGRID_API_KEY=SG....

# Verified sender email address for outbound digest emails
SENDGRID_FROM_EMAIL=hello@yourdomain.com

# ── Mobile App (Expo) ─────────────────────────────────────────────────────────
# These are injected automatically by the mobile dev script on Replit.
# For local development outside Replit, set them manually.

# Public base URL of the API server (no trailing slash)
EXPO_PUBLIC_API_BASE_URL=https://your-domain.com

# Your domain (used for Clerk proxy config)
EXPO_PUBLIC_DOMAIN=your-domain.com

# Clerk proxy URL for the mobile app
EXPO_PUBLIC_CLERK_PROXY_URL=https://your-domain.com/api/__clerk

# Clerk publishable key for the mobile app
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# ── Session (legacy / optional) ───────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string
